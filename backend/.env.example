NODE_ENV=development
PORT=3000
# 浠ュ崐瑙掗€楀彿鍒嗛殧鐨勫厑璁歌法鍩熸簮锛涚敓浜у繀椤绘樉寮忚缃紙渚嬪 https://admin.example.com,https://client.example.com锛?CORS_ORIGINS=http://localhost:5998,http://localhost:5999

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=secret
DB_DATABASE=new_kjqb
# 本地开发按需设为 true；测试、预发布与生产必须为 false，并通过 npm run db:migrate 管理结构。
DB_SYNCHRONIZE=true

# Redis is prepared in stage 1 and remains disabled until the Session migration stage.
REDIS_ENABLED=false
REDIS_URL=
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0
REDIS_KEY_PREFIX=kjqb:auth:
REDIS_CONNECT_TIMEOUT_MS=1500

# Session store migration stage: keep memory until Redis connectivity is verified.
AUTH_SESSION_STORE=memory
# 方案 C：只开放客户端登录入口，管理端登录默认拒绝。
AUTH_CLIENT_ONLY=true

ACCESS_TOKEN_TTL=2h
REFRESH_TOKEN_TTL=7d
SESSION_COOKIE_NAME=new_kjqb_refresh_token
# 登录失败在应用进程内按账号和来源地址限制为 15 分钟内 5 次；多实例生产环境应接入共享限流存储。

# 统一认证改造阶段 0：默认保持现有随机 Token + 内存 Session 行为。
# 后续阶段会依次启用 Redis、JWT 和跨域 SSO；在对应功能发布前请保持以下默认值。
AUTH_APP_CODE=kjqb
AUTH_TOKEN_MODE=legacy
AUTH_SSO_ENABLED=false
AUTH_JWT_ISSUER=kjqb-auth
AUTH_JWT_KEY_ID=kjqb-auth-2026-01
AUTH_JWT_PRIVATE_KEY=
AUTH_JWT_PUBLIC_KEY=

TIANYANCHA_BASE_URL=https://open.api.tianyancha.com/services/open
TIANYANCHA_TOKEN=
CRM_SYNC_TOKEN=
# 32 字节随机值的 Base64URL 编码。用于加密数据库中的 CRM v2 签名密钥；生产环境必须配置且长期保留。
CRM_INTEGRATION_ENCRYPTION_KEY=
CRM_SYNC_POLL_ENABLED=1
CRM_SYNC_POLL_INTERVAL_MS=30000
CRM_SYNC_BATCH_SIZE=20
CRM_SYNC_MAX_RETRY=3
CRM_SYNC_PROCESSING_TIMEOUT_MS=900000
TIANYANCHA_TIMEOUT_MS=8000
TIANYANCHA_SEARCH_PATH=search/2.0
TIANYANCHA_BASEINFO_WITH_STAFF_PATH=ic/baseinfoV3/2.0

AI_PROVIDER=psydo
AI_API_KEY=
AI_BASE_URL=https://api.psydo.top/v1
AI_MODEL=gpt-6-astra
# 按顺序自动切换；AI_MODEL（若设置）优先。
AI_MODELS=gpt-6-astra,gpt-6-sol,gpt-5.6-sol
AI_VISION_MODEL=gpt-6-astra
AI_TIMEOUT_MS=60000
AI_FINANCE_VISION_ENABLE=1
AI_IP_VISION_ENABLE=1
AI_CONTRACT_VISION_ENABLE=1
AI_CONTRACT_VISION_MAX_PAGES=4
AI_EMPLOYEE_PDF_VISION_ENABLE=1
AI_EMPLOYEE_PDF_MAX_PAGES=5
AI_CLIENT_PROPERTY_ENABLE=1
AI_POLICY_COLLECT_ENABLE_SEARCH=1
PDF_RENDER_DPI=180
PDFTOPPM_PATH=

OCR_PROVIDER=none
OCR_HTTP_URL=
OCR_HTTP_API_KEY=
OCR_TIMEOUT_MS=60000
