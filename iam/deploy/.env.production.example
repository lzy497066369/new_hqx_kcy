# Public IAM URL. It must match the external HTTPS address used by OAuth clients.
IAM_ISSUER=https://iam.example.com
IAM_CORS_ORIGIN=https://iam.example.com,https://admin.example.com,https://client.example.com
IAM_TRUST_PROXY=true
IAM_HTTP_PORT=8081

# Generate and store a stable RSA private key outside source control.
IAM_JWT_PRIVATE_KEY_BASE64=
IAM_JWT_KEY_ID=iam-rs256-1
# JSON array of retired public JWKs retained until old tokens and JWKS caches expire.
IAM_JWT_ADDITIONAL_PUBLIC_JWKS_JSON=[]
IAM_ENABLE_BOOTSTRAP_LOGIN=false
IAM_ADMIN_SESSION_TTL_SECONDS=28800

# IAM owns a separate MySQL schema. Do not point it to the legacy business schema.
IAM_DB_HOST=127.0.0.1
IAM_DB_PORT=3306
IAM_DB_DATABASE=iam_sso
IAM_DB_USERNAME=iam_service
IAM_DB_PASSWORD=
