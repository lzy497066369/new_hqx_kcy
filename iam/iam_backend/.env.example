PORT=3101
IAM_ISSUER=http://localhost:3101
IAM_CORS_ORIGIN=http://localhost:6101,http://localhost:5998,http://localhost:5999,http://127.0.0.1:6101,http://127.0.0.1:5998,http://127.0.0.1:5999
# Set true only when IAM is behind one trusted reverse proxy.
# IAM_TRUST_PROXY=true
IAM_BOOTSTRAP_USERNAME=iam_admin
IAM_BOOTSTRAP_PASSWORD=ChangeMe123!
# IAM_ADMIN_SESSION_TTL_SECONDS=28800
# Defaults to false in production. Disable after creating the first database super_admin.
# IAM_ENABLE_BOOTSTRAP_LOGIN=false
# Used only by `npm run bootstrap:admin`; never commit a production password.
# IAM_INITIAL_ADMIN_USERNAME=
# IAM_INITIAL_ADMIN_PASSWORD=
# IAM_INITIAL_ADMIN_REAL_NAME=IAM Administrator
# Production must use a stable RSA private key encoded as base64 and a stable key id.
# IAM_JWT_PRIVATE_KEY_BASE64=
# IAM_JWT_KEY_ID=iam-rs256-1
# Keep retired public JWKs during key rotation, as a JSON array. Never place private keys here.
# IAM_JWT_ADDITIONAL_PUBLIC_JWKS_JSON=[]

# The IAM database is intentionally separate from the current business schema.
IAM_DB_HOST=127.0.0.1
IAM_DB_PORT=3306
IAM_DB_USERNAME=root
IAM_DB_PASSWORD=
IAM_DB_DATABASE=iam_sso
