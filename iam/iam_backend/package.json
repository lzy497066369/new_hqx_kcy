{
  "name": "iam-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Unified IAM and SSO backend service",
  "scripts": {
    "build": "node ../../backend/node_modules/@nestjs/cli/bin/nest.js build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "lint": "tsc -p tsconfig.json --noEmit",
    "bootstrap:admin": "node scripts/bootstrap-iam-admin.cjs",
    "db:migrate": "node scripts/migrate-iam-schema.cjs",
    "import:legacy": "node scripts/import-legacy-data.cjs",
    "test": "npm run build && node --test test/**/*.test.cjs",
    "cleanup:test-records": "node scripts/cleanup-test-records.cjs",
    "verify:test-cleanup": "node scripts/verify-test-cleanup.cjs",
    "verify:business-sso-e2e": "node scripts/verify-business-sso-e2e.cjs"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.8",
    "@nestjs/core": "^10.4.8",
    "@nestjs/platform-express": "^10.4.8",
    "@nestjs/typeorm": "^10.0.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "^17.4.2",
    "mysql2": "^3.14.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.26"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.8",
    "@types/node": "^22.16.5",
    "typescript": "^5.9.2"
  }
}
