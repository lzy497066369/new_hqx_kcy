# 科创企服客户端 IAM 模式模板
# 将实际公网域名替换为部署域名，并在 IAM 管理端精确登记回调地址。

# backend
IAM_AUTH_MODE=jwt
IAM_ISSUER=https://iam.example.com
IAM_JWKS_URL=https://iam.example.com/.well-known/jwks.json
IAM_CONTEXT_URL=https://iam.example.com
IAM_APP_CODE=kjqb_client
IAM_CLIENT_ID=kjqb_client_web
IAM_PORTAL=client
IAM_COMPANY_SOURCE_SYSTEM=hqx_kjqb
IAM_COMPANY_SCOPE_CACHE_TTL_MS=30000

# frontend
VITE_AUTH_MODE=iam
VITE_IAM_ISSUER=https://iam.example.com
VITE_IAM_CLIENT_ID=kjqb_client_web
VITE_IAM_REDIRECT_URI=https://client.example.com/auth/callback
VITE_APP_CODE=kjqb_client
